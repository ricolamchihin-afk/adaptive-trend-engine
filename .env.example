# Smart Grid - Phase 7.10 dynamic trend follower (Phoenix, 1000 USDC)
# Copy to .env.local and edit. Values here are the current strategy defaults.
#
# =============================================================================
#  GO-LIVE IS DISABLED BY DESIGN.
#  This repository has NO exchange write adapter and cannot place, cancel, or
#  resize an order. Setting LIVE_TRADING_ENABLED=true does NOT trade — a vetted,
#  reviewed write adapter must be built first, and the hard risk limits below
#  must be enforced by that adapter before a single live order. Never commit
#  real API keys; provide them only through an untracked .env.local or a secrets
#  manager. The strategy is validated on paper only; past backtest performance
#  is not a guarantee of live results.
# =============================================================================

# --- Strategy parameters (safe to tune; mirror the Backtest lab controls) ---
SG_CAPITAL_USD=1000
SG_MAX_LEVERAGE=20
SG_RISK_PCT=0.03
SG_DONCHIAN_ENTRY=34
SG_DONCHIAN_EXIT=5
SG_ATR_PERIOD=14
SG_ATR_STOP_MULT=3
SG_ADX_PERIOD=14
SG_ADX_THRESHOLD=0
SG_RSI_PERIOD=14
SG_RSI_LONG_MIN=50
SG_RSI_SHORT_MAX=50
SG_DAILY_EMA_PERIOD=150
# Fixed take-profit in ROE percent of equity at entry. 0 = let winners run to trailing exit.
SG_TAKE_PROFIT_ROE=0
# Dynamic take-profit: TP percent = factor x ADX(at entry), clamped to [min,max].
# Factor 1.0 was best in trial-and-error. Set 0 to use the fixed take-profit above.
SG_TP_ADX_FACTOR=1.0
SG_TP_MIN_ROE=10
SG_TP_MAX_ROE=60

# --- Go-live gate (DISABLED placeholders) ---
LIVE_TRADING_ENABLED=false
EXCHANGE=phoenix
EXCHANGE_ACCOUNT_LABEL=

# --- Phoenix Perpetuals live adapter (Ellipsis Labs Rise SDK) ---
PHOENIX_API_URL=https://perp-api.phoenix.trade
# Solana RPC endpoint used to sign / submit / confirm transactions:
SOLANA_RPC_URL=
# Trader signer: a Solana secret key (JSON byte array or base58). Signs live orders.
# Populate only via an untracked .env / secrets manager, never in git.
PHOENIX_AUTHORITY=
PHOENIX_MARKET_SYMBOL=BTC
PHOENIX_TRADER_INDEX=0
# HARD SAFETY GATE: order submission is refused until this is true. Only set true
# AFTER verifying the adapter on testnet with tiny size.
PHOENIX_ADAPTER_VERIFIED=false

# Hard risk limits enforced before any live order:
LIVE_MAX_NOTIONAL_USD=0
LIVE_DAILY_LOSS_LIMIT_USD=0
LIVE_MAX_DRAWDOWN_PCT=0
