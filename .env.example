# Smart Grid - Phase 7.10 dynamic trend follower (Phoenix, 2000 USDC)
# Copy to .env.local and edit. Values here are the current strategy defaults.
#
# =============================================================================
#  Live trading is gated: LIVE_TRADING_ENABLED + PHOENIX_ADAPTER_VERIFIED +
#  a signing key. LIVE_AUTO_4H (default on) opens/closes on each closed 4h bar.
#  Kill flattens Phoenix. Never commit real API keys.
# =============================================================================

# --- Strategy parameters (live Phoenix BTC book) ---
SG_CAPITAL_USD=2000
SG_MAX_LEVERAGE=20
SG_RISK_PCT=0.10
SG_DONCHIAN_ENTRY=55
SG_DONCHIAN_EXIT=7
SG_ATR_PERIOD=14
SG_ATR_STOP_MULT=2
SG_ADX_PERIOD=14
SG_ADX_THRESHOLD=0
SG_RSI_PERIOD=14
SG_RSI_LONG_MIN=50
SG_RSI_SHORT_MAX=50
SG_DAILY_EMA_PERIOD=150
SG_TAKE_PROFIT_ROE=0
SG_TP_ADX_FACTOR=1.2
SG_TP_MIN_ROE=10
SG_TP_MAX_ROE=60

# --- Go-live gate ---
LIVE_TRADING_ENABLED=true
EXCHANGE=phoenix
EXCHANGE_ACCOUNT_LABEL=

# --- Phoenix Perpetuals live adapter (Ellipsis Labs Rise SDK) ---
PHOENIX_API_URL=https://perp-api.phoenix.trade
# Solana RPC endpoint used to sign / submit / confirm transactions
# (PHOENIX_SOLANA_RPC is preferred; SOLANA_RPC_URL also accepted):
PHOENIX_SOLANA_RPC=
# Signer secret key that signs live orders. Provide ONE of these (never commit real
# values). The adapter auto-detects JSON byte-array OR base58 — no conversion needed:
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=
# Trader authority PUBLIC key (optional; derived from the signer if omitted):
PHOENIX_AUTHORITY=
PHOENIX_MARKET_SYMBOL=BTC
PHOENIX_TRADER_INDEX=0
# HARD SAFETY GATE: order submission also requires LIVE_TRADING_ENABLED=true.
# Tiny 1-lot BTC market order confirmed on Phoenix.
PHOENIX_ADAPTER_VERIFIED=true

# 4h auto-loop. Keep `npm run start` or `npm run trade` running 24/7.
# You do not POST. Kill (console) flattens Phoenix and blocks new entries.
LIVE_AUTO_4H=true
# Size the next trade on Phoenix collateral (wins raise size, losses shrink it).
LIVE_COMPOUND=true

# Risk. Compounding ignores a static notional cap (20x of live equity binds).
# Daily loss $400 is for $2000; it scales as collateral grows. Max DD 40% of peak.
LIVE_MAX_NOTIONAL_USD=0
LIVE_DAILY_LOSS_LIMIT_USD=400
LIVE_MAX_DRAWDOWN_PCT=40

# Optional Telegram. Off unless all three are set. The bot pings on each new 4h
# bar (WATCH) and on open/close. Never commit a real token.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
