# Smart Grid - Phase 7.10 dynamic trend follower (Phoenix, 1000 USDC)
# Copy to .env.local and edit. Values here are the current strategy defaults.
#
# =============================================================================
#  Live trading is gated: LIVE_TRADING_ENABLED + PHOENIX_ADAPTER_VERIFIED +
#  a signing key. POST /api/dry-run then submits the current long/short plan.
#  Never commit real API keys. Past backtest performance is not a guarantee.
# =============================================================================

# --- Strategy parameters (safe to tune; mirror the Backtest lab controls) ---
SG_CAPITAL_USD=1000
SG_MAX_LEVERAGE=20
SG_RISK_PCT=0.03
SG_DONCHIAN_ENTRY=34
SG_DONCHIAN_EXIT=5
SG_ATR_PERIOD=14
SG_ATR_STOP_MULT=3
SG_ADX_PERIOD=14
SG_ADX_THRESHOLD=0
SG_RSI_PERIOD=14
SG_RSI_LONG_MIN=50
SG_RSI_SHORT_MAX=50
SG_DAILY_EMA_PERIOD=150
# Fixed take-profit in ROE percent of equity at entry. 0 = let winners run to trailing exit.
SG_TAKE_PROFIT_ROE=0
# Dynamic take-profit: TP percent = factor x ADX(at entry), clamped to [min,max].
# Factor 1.0 was best in trial-and-error. Set 0 to use the fixed take-profit above.
SG_TP_ADX_FACTOR=1.0
SG_TP_MIN_ROE=10
SG_TP_MAX_ROE=60

# --- Go-live gate ---
LIVE_TRADING_ENABLED=true
EXCHANGE=phoenix
EXCHANGE_ACCOUNT_LABEL=

# --- Phoenix Perpetuals live adapter (Ellipsis Labs Rise SDK) ---
PHOENIX_API_URL=https://perp-api.phoenix.trade
# Solana RPC endpoint used to sign / submit / confirm transactions
# (PHOENIX_SOLANA_RPC is preferred; SOLANA_RPC_URL also accepted):
PHOENIX_SOLANA_RPC=
# Signer secret key that signs live orders. Provide ONE of these (never commit real
# values). The adapter auto-detects JSON byte-array OR base58 — no conversion needed:
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=
# Trader authority PUBLIC key (optional; derived from the signer if omitted):
PHOENIX_AUTHORITY=
PHOENIX_MARKET_SYMBOL=BTC
PHOENIX_TRADER_INDEX=0
# HARD SAFETY GATE: order submission also requires LIVE_TRADING_ENABLED=true.
# Tiny 1-lot BTC market order confirmed on Phoenix.
PHOENIX_ADAPTER_VERIFIED=true

# Hard risk limits: notional is clamped in the planner. $20k = 20x on $1000.
LIVE_MAX_NOTIONAL_USD=20000
LIVE_DAILY_LOSS_LIMIT_USD=100
LIVE_MAX_DRAWDOWN_PCT=25
